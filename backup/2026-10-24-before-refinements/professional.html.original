<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Amatya Sharma | Research</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="author" content="Amatya Sharma">
  <meta name="description" content="Research, publications, talks, and CV of Amatya Sharma, a theoretical computer science Ph.D. candidate at the University of Michigan.">
  <link rel="canonical" href="https://aaysharma.github.io/professional.html">
  <meta property="og:type" content="website">
  <meta property="og:title" content="Amatya Sharma | Research and Publications">
  <meta property="og:description" content="Research, publications, talks, and CV in theoretical computer science at the University of Michigan.">
  <meta property="og:url" content="https://aaysharma.github.io/professional.html">
  <meta property="og:image" content="https://aaysharma.github.io/images/circle_cropped_whiteshirt_aaysharma.png">
  <meta property="og:image:alt" content="Amatya Sharma">
  <meta name="twitter:card" content="summary">
  <link rel="icon" href="images/umich.png">

  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Alegreya+Sans:wght@400..700&display=swap">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/jpswalsh/academicons@1/css/academicons.min.css">

  <style>
    /* =========================================================
       Site-wide design variables.
       Change colors, margins, navbar width, font, and text weight here.
       ========================================================= */
    :root {
      --page-width: none;
      --side-margin: 270px;
      --content-gap-from-nav: 20px;
      /* Default theme: soft green. Change the theme by editing the <body> class below.
         Available choices:
         theme-soft-green, theme-muted-sage, theme-blue-gray, theme-warm-cream,
         theme-minimal-gray, theme-slate-teal, theme-lavender, theme-sandstone,
         theme-forest, theme-michigan-blue.
      */
      --link-blue: #2f855a;
      --accent-orange: #c8742f;
      --soft-border: #dfe8df;
      --muted-text: #5e6f5e;
      --body-text: #222;
      --page-bg: #ffffff;

      --nav-bg: rgba(237, 254, 223, 0.78);
      --nav-bg-strong: rgba(237, 254, 223, 0.92);
      --nav-hover: #c1e1c1;
      --nav-text: #3a6b3a;
      --nav-text-hover: #234923;
      --side-border: #b8d9b8;
      --card-hover: #f8fcf6;
      --image-bg: #f8fcf6;
      --placeholder-bg: #f1faee;
      --placeholder-border: #cfe6cf;
      --social-bg: #f5f8f3;
      --social-hover-bg: #e5f3e2;
      --vertical-nav-width: 230px;
      --normal-text-weight: 450;

      /*
        Background options are controlled by adding/removing a class on <body>.
        See the <body> comment near the bottom of <head>.

        Default values below mean: no decorative background.
      */
      --site-bg-image: none;
      --site-bg-overlay: rgba(255, 255, 255, 0);
      --site-bg-repeat: no-repeat;
      --site-bg-position: center top;
      --site-bg-size: cover;
      --site-bg-attachment: scroll;
      /*
        Font options. Change --site-font-family to any one of these:
        1. 'Lato', Verdana, Helvetica, sans-serif;
        2. 'Source Sans 3', Verdana, Helvetica, sans-serif;
        3. 'Inter', Verdana, Helvetica, sans-serif;
        4. 'IBM Plex Sans', Verdana, Helvetica, sans-serif;
        5. 'Alegreya Sans', Verdana, Helvetica, sans-serif;
      */
      --site-font-family: 'Alegreya Sans', Verdana, Helvetica, sans-serif;
    }

    /* =========================================================
       Theme presets.
       To choose a theme, edit the <body> class near the bottom of <head>.
       Example: <body class="nav-vertical theme-soft-green">
       ========================================================= */

    body.theme-soft-green {
      --link-blue: #2f855a;
      --accent-orange: #c8742f;
      --soft-border: #dfe8df;
      --muted-text: #5e6f5e;
      --nav-bg: rgba(237, 254, 223, 0.78);
      --nav-bg-strong: rgba(237, 254, 223, 0.92);
      --nav-hover: #c1e1c1;
      --nav-text: #3a6b3a;
      --nav-text-hover: #234923;
      --side-border: #b8d9b8;
      --card-hover: #f8fcf6;
      --image-bg: #f8fcf6;
      --placeholder-bg: #f1faee;
      --placeholder-border: #cfe6cf;
      --social-bg: #f5f8f3;
      --social-hover-bg: #e5f3e2;
    }

    body.theme-muted-sage {
      --link-blue: #276749;
      --accent-orange: #c46a28;
      --nav-bg: rgba(232, 242, 232, 0.88);
      --nav-bg-strong: rgba(232, 242, 232, 0.96);
      --nav-hover: #d2e4d2;
      --nav-text: #355f44;
      --nav-text-hover: #244431;
      --side-border: #bdd8c0;
      --card-hover: #f7faf7;
      --social-hover-bg: #e7f3e7;
    }

    body.theme-blue-gray {
      --link-blue: #1f5f8b;
      --accent-orange: #b35c1e;
      --nav-bg: rgba(235, 243, 250, 0.86);
      --nav-bg-strong: rgba(235, 243, 250, 0.96);
      --nav-hover: #d7e8f7;
      --nav-text: #244966;
      --nav-text-hover: #16344d;
      --side-border: #b9d5ea;
      --card-hover: #f7fbff;
      --social-hover-bg: #e8f3fb;
    }

    body.theme-warm-cream {
      --link-blue: #2364a3;
      --accent-orange: #c26924;
      --nav-bg: rgba(255, 246, 226, 0.88);
      --nav-bg-strong: rgba(255, 246, 226, 0.96);
      --nav-hover: #f3dfb8;
      --nav-text: #6a4a1f;
      --nav-text-hover: #3f2b10;
      --side-border: #ead3a6;
      --card-hover: #fffaf0;
      --social-hover-bg: #fff0d8;
    }

    body.theme-minimal-gray {
      --link-blue: #205ea8;
      --accent-orange: #a85f2a;
      --nav-bg: rgba(245, 245, 245, 0.92);
      --nav-bg-strong: rgba(248, 248, 248, 0.98);
      --nav-hover: #e7e7e7;
      --nav-text: #333333;
      --nav-text-hover: #111111;
      --side-border: #d6d6d6;
      --card-hover: #f8f8f8;
      --social-hover-bg: #eeeeee;
    }

    body.theme-slate-teal {
      --link-blue: #1c6e73;
      --accent-orange: #b96a3a;
      --nav-bg: rgba(229, 241, 240, 0.90);
      --nav-bg-strong: rgba(229, 241, 240, 0.97);
      --nav-hover: #cde4e2;
      --nav-text: #285b5f;
      --nav-text-hover: #183f42;
      --side-border: #aacdca;
      --card-hover: #f5fbfa;
      --social-hover-bg: #def0ef;
    }

    body.theme-lavender {
      --link-blue: #4a63a8;
      --accent-orange: #b5652f;
      --nav-bg: rgba(242, 238, 250, 0.90);
      --nav-bg-strong: rgba(242, 238, 250, 0.97);
      --nav-hover: #ded5f2;
      --nav-text: #4f4778;
      --nav-text-hover: #312a55;
      --side-border: #cfc3eb;
      --card-hover: #faf8ff;
      --social-hover-bg: #eee8fb;
    }

    body.theme-sandstone {
      --link-blue: #2f6f95;
      --accent-orange: #b9702f;
      --nav-bg: rgba(246, 238, 225, 0.90);
      --nav-bg-strong: rgba(246, 238, 225, 0.97);
      --nav-hover: #e7d6be;
      --nav-text: #5f4b32;
      --nav-text-hover: #3c2e1d;
      --side-border: #d7c0a2;
      --card-hover: #fcf8f2;
      --social-hover-bg: #f2e5d4;
    }

    body.theme-forest {
      --link-blue: #216e4e;
      --accent-orange: #c77a2d;
      --nav-bg: rgba(225, 238, 228, 0.91);
      --nav-bg-strong: rgba(225, 238, 228, 0.98);
      --nav-hover: #c4dccb;
      --nav-text: #244f35;
      --nav-text-hover: #153520;
      --side-border: #a9ccb3;
      --card-hover: #f5faf6;
      --social-hover-bg: #e2f0e6;
    }

    body.theme-michigan-blue {
      --link-blue: #00274c;
      --accent-orange: #b46a00;
      --nav-bg: rgba(231, 238, 247, 0.92);
      --nav-bg-strong: rgba(231, 238, 247, 0.98);
      --nav-hover: #c9d8ea;
      --nav-text: #00274c;
      --nav-text-hover: #001a33;
      --side-border: #b7c9df;
      --card-hover: #f6f9fd;
      --social-hover-bg: #e0ebf7;
    }

    /* =========================================================
       Background presets.
       Choose one background class in <body>:
       - bg-none: no decorative background
       - bg-doodle-portrait: rotated/portrait doodle, repeated along page length
       - bg-doodle-landscape: fixed full-page doodle background

       Both modes use the existing images/Rough-22-portrait.jpg asset.
       ========================================================= */

    body.bg-none {
      --site-bg-image: none;
      --site-bg-overlay: rgba(255, 255, 255, 0);
      --site-bg-repeat: no-repeat;
      --site-bg-position: center top;
      --site-bg-size: cover;
      --site-bg-attachment: scroll;
    }

    body.bg-doodle-portrait {
      --site-bg-image: url("images/Rough-22-portrait.jpg");
      --site-bg-overlay: rgba(255, 255, 255, 0.77);
      --site-bg-repeat: repeat-y;
      --site-bg-position: center top;
      --site-bg-size: 100% auto;
      --site-bg-attachment: scroll;
    }

    body.bg-doodle-landscape {
      --site-bg-image: url("images/Rough-22-portrait.jpg");
      --site-bg-overlay: rgba(255, 255, 255, 0.78);
      --site-bg-repeat: no-repeat;
      --site-bg-position: center top;
      --site-bg-size: cover;
      --site-bg-attachment: fixed;
    }

    /* Base typography and page behavior. */
    html {
      scroll-behavior: smooth;
      font-size: 15px;
    }

    body,
    html {
      overflow-x: hidden;
    }

    /* Main body text style. Backgrounds use the variables configured above. */

    body {
      margin: 0;
      font-family: var(--site-font-family);
      background-color: var(--page-bg);
      background-image:
        linear-gradient(var(--site-bg-overlay), var(--site-bg-overlay)),
        var(--site-bg-image);
      background-repeat: var(--site-bg-repeat);
      background-position: var(--site-bg-position);
      background-size: var(--site-bg-size);
      background-attachment: var(--site-bg-attachment);
      color: var(--body-text);
      line-height: 1.5em;
      word-spacing: 0.09em;
      letter-spacing: 0.025em;
      font-weight: var(--normal-text-weight);
    }

    body,
    p,
    a {
      font-family: var(--site-font-family);
      font-size: 1rem;
      font-weight: var(--normal-text-weight);
    }

    /* Headings are intentionally heavier than normal text. */
    h1,
    h2,
    h3 {
      line-height: 1.25;
    }

    h1 {
      font-size: 1.8rem;
      margin: 0 0 16px 0;
      padding-bottom: 6px;
      border-bottom: 1px solid var(--soft-border);
      letter-spacing: 0.01em;
      font-weight: 700;
    }

    h2 {
      font-size: 1.5rem;
      margin: 0 0 12px 0;
      font-weight: 700;
    }

    h3 {
      font-size: 1.2rem;
      margin: 0 0 4px 0;
      font-weight: 700;
    }

    p {
      margin: 8px 0;
    }

    a {
      color: var(--link-blue);
      text-decoration: none;
    }

    a:focus,
    a:hover {
      color: var(--accent-orange);
      text-decoration: none;
    }

    /* =========================================================
       Navigation.
       NAVBAR TOGGLE:
      - Use <body class="nav-vertical theme-muted-sage"> for the fixed vertical navbar.
      - Use <body class="nav-horizontal"> for the sticky horizontal navbar.
       ========================================================= */

    .top-header,
    .vertical-header {
      display: none;
    }

    body.nav-horizontal .top-header {
      display: block;
    }

    body.nav-vertical .vertical-header {
      display: block;
    }

    .top-header {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      width: 100%;
      z-index: 1000;
      background: var(--nav-bg-strong);
      border-bottom: 1px solid var(--side-border);
      backdrop-filter: blur(8px);
      box-sizing: border-box;
    }

    .top-navbar {
      max-width: none;
      margin: 0 var(--side-margin);
      padding: 10px 20px;
      display: flex;
      gap: 16px;
      justify-content: center;
      flex-wrap: wrap;
    }

    .top-navbar a {
      color: var(--nav-text);
      font-size: 0.95rem;
      white-space: nowrap;
    }

    .top-navbar a:hover {
      color: var(--nav-text-hover);
    }

    .top-navbar a.active {
      background-color: var(--link-blue);
      color: white;
      border-radius: 999px;
      padding: 3px 9px;
      font-weight: 700;
    }

    .top-navbar a.active:hover {
      color: white;
      background-color: var(--nav-text-hover);
    }

    #vertical-navbar {
      position: fixed;
      top: 50%;
      left: 0;
      width: var(--vertical-nav-width);
      height: auto;
      padding: 12px 0;
      z-index: 1000;
      background-color: var(--nav-bg);
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.10);
      backdrop-filter: blur(10px);
      transform: translateY(-50%);
    }

    #vertical-navbar ul {
      list-style-type: none;
      padding: 0;
      margin: 0;
      width: 100%;
    }

    #vertical-navbar li {
      width: 100%;
    }

    #vertical-navbar a {
      display: block;
      width: 100%;
      box-sizing: border-box;
      padding: 10px 16px;
      color: var(--nav-text);
      text-decoration: none;
      transition: background-color 0.25s ease, color 0.25s ease;
    }

    #vertical-navbar a:hover {
      background-color: var(--nav-hover);
      color: var(--nav-text-hover);
    }

    #vertical-navbar a.active {
      background-color: var(--link-blue);
      color: white;
      font-weight: 700;
    }

    /* Main content area. In vertical-nav mode, left margin leaves room for the sidebar. */
    main {
      max-width: none;
      margin: 0;
      padding: 36px 20px 60px 20px;
    }

    body.nav-vertical main {
      margin-left: calc(var(--vertical-nav-width) + var(--content-gap-from-nav));
      margin-right: var(--side-margin);
    }

    body.nav-horizontal main {
      margin-left: var(--side-margin);
      margin-right: var(--side-margin);
      padding-top: 86px;
    }

    body.nav-horizontal main {
      padding-top: 86px;
    }

    /* Shared section spacing. */
    section {
      margin: 52px 0;
      scroll-margin-top: 70px;
    }

    #home {
      margin-top: 0;
      text-align: center;
    }

    .container {
      max-width: none;
      margin: 0;
      padding: 0;
    }

    /* Profile photo, name block, and social links. */
    .home-photo {
      width: 190px;
      max-width: 55vw;
      border-radius: 50%;
    }

    .name-heading {
      font-size: 2em;
      font-weight: bold;
    }

    .home-intro {
      margin-top: 18px;
      text-align: left;
    }

    .social-links {
      margin: 10px 0 16px 0;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 6px;
      flex-wrap: wrap;
    }

    .social-links a.fa,
    .social-links a.ai {
      background-color: var(--social-bg);
      border-radius: 20px;
      padding: 6px 10px;
      margin: 5px;
      display: inline-block;
      color: var(--muted-text);
      font-size: 24px;
      line-height: 1;
      transition: transform 0.2s ease, background-color 0.2s ease, color 0.2s ease;
    }

    .social-links a.fa:hover,
    .social-links a.ai:hover {
      color: var(--link-blue);
      transform: scale(1.1);
      background-color: var(--social-hover-bg);
    }

    /* News and collaborators share a two-column layout on desktop. */
    .news-collab-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(260px, 0.75fr);
      gap: 42px;
      align-items: start;
    }

    .news-box {
      height: 330px;
      overflow-y: auto;
      padding-left: 12px;
      border-left: 2px solid var(--side-border);
      margin-left: 2px;
      scrollbar-width: thin;
      box-sizing: border-box;
    }

    .news-item {
      display: flex;
      gap: 12px;
      margin-bottom: 12px;
    }

    .news-date {
      min-width: 88px;
      /*font-style: italic;*/
      color: var(--muted-text);
    }

    .news-text {
      flex: 1;
    }

    /* Publication/project/talk cards. Images are vertically centered with text. */
    .publication {
      display: flex;
      gap: 18px;
      padding: 18px 0;
      border-bottom: 1px solid var(--soft-border);
      align-items: center;
      transition: background-color 0.18s ease;
    }

    .publication:hover {
      background-color: var(--card-hover);
    }

    .publication img {
      width: 135px;
      max-height: 120px;
      object-fit: contain;
      flex-shrink: 0;
      cursor: pointer;
      border-radius: 4px;
      background: var(--image-bg);
      box-sizing: border-box;
    }

    .publication-placeholder {
      width: 135px;
      height: 90px;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 4px;
      background: var(--placeholder-bg);
      color: var(--nav-text);
      font-weight: 700;
      letter-spacing: 0.03em;
      border: 1px solid var(--placeholder-border);
      box-sizing: border-box;
    }

    .collaborators-box {
      height: 330px;
      overflow-y: auto;
      padding-left: 12px;
      border-left: 2px solid var(--side-border);
      scrollbar-width: thin;
      box-sizing: border-box;
    }

    .collaborators-list {
      columns: 1;
      padding-left: 20px;
      margin: 0;
    }

    .collaborators-list li {
      break-inside: avoid;
      margin-bottom: 6px;
    }

    .publication-content {
      flex: 1;
      min-width: 260px;
      text-align: left;
    }

    .publication p {
      margin: 4px 0;
      line-height: 1.45;
    }

    .publication p a {
      font-size: inherit;
      color: var(--link-blue);
      margin: 0.25em 0;
    }

    .publication p a:hover {
      text-decoration: underline;
    }

    .publication-icons a {
      margin-right: 5px;
    }

    .publication-icons i {
      font-size: 1.05rem;
    }

    /* Compact list layout for experience and awards. */
    .experience-list,
    .awards-list {
      padding-left: 20px;
      margin: 0;
    }

    .experience-entry {
      margin-bottom: 7px;
      line-height: 1.45;
    }

    .job-dates {
      float: right;
      margin-left: 16px;
      font-style: italic;
      color: var(--muted-text);
    }

    .job-title a {
      color: var(--link-blue);
      text-decoration: none;
    }

    .job-title a:hover {
      text-decoration: underline;
    }

    .experience-logo {
      vertical-align: middle;
      margin-left: 6px;
      max-height: 44px;
      object-fit: contain;
    }

    .experience-logos {
      white-space: nowrap;
    }

    /* Calendar/contact two-column block. */
    .calendar-contact-wrapper {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 28px;
    }

    .calendar-column,
    .contact-column {
      flex: 1;
    }

    .contact-column {
      text-align: right;
    }

    /* Floating back-to-top button. */
    .back-to-top {
      position: fixed;
      bottom: 20px;
      right: 20px;
      border: none;
      background: var(--link-blue);
      color: white;
      border-radius: 50%;
      padding: 10px 14px;
      font-size: 16px;
      cursor: pointer;
      z-index: 999;
      transition: background-color 0.18s ease, transform 0.18s ease;
    }

    .back-to-top:hover {
      background: var(--accent-orange);
      transform: translateY(-1px);
    }

    /* Medium screens: hide vertical navbar and switch to top navbar. */
    @media (max-width: 1180px) {
      :root {
        --side-margin: 40px;
      }

      body.nav-vertical .vertical-header {
        display: none;
      }

      body.nav-vertical .top-header {
        display: block;
      }

      body.nav-vertical main {
        margin-left: var(--side-margin);
        margin-right: var(--side-margin);
        padding-top: 86px;
      }
    }

    /* Small screens: keep publication/project/talk cards side-by-side, with smaller thumbnails. */
    @media (max-width: 820px) {
      body.nav-vertical main,
      body.nav-horizontal main {
        max-width: none;
        margin-left: 20px;
        margin-right: 20px;
        padding: 76px 20px 60px 20px;
      }

      .top-navbar {
        margin: 0 20px;
        justify-content: flex-start;
        overflow-x: auto;
        flex-wrap: nowrap;
      }

      .publication {
        flex-direction: row;
        gap: 12px;
        align-items: center;
      }

      .publication > a:first-child,
      .publication > div:first-child:not(.publication-content) {
        flex: 0 0 96px;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .publication-content {
        min-width: 0;
      }

      .news-collab-grid {
        grid-template-columns: 1fr;
        gap: 34px;
      }

      .collaborators-list {
        columns: 1;
      }

      .publication img {
        width: 96px;
        max-width: 96px;
        max-height: 90px;
      }

      .job-dates {
        float: none;
        display: block;
        margin-left: 0;
      }

      .calendar-contact-wrapper {
        flex-direction: column;
      }

      .contact-column {
        text-align: left;
      }

      iframe {
        max-width: 100%;
      }
    }

    /* Very small screens: stack news dates above news text. */
    @media (max-width: 560px) {
      .news-item {
        flex-direction: column;
        gap: 2px;
      }

      .news-date {
        min-width: 0;
      }

      .publication {
        gap: 10px;
      }

      .publication > a:first-child,
      .publication > div:first-child:not(.publication-content) {
        flex-basis: 82px;
      }

      .publication img {
        width: 82px;
        max-width: 82px;
        max-height: 78px;
      }

      .home-photo {
        width: 160px;
      }
    }
  </style>
  <link rel="stylesheet" href="professional.css">
</head>

