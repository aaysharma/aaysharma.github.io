<script>
  // Old section links also open the disclosure that contains their target.
  document.addEventListener("DOMContentLoaded", () => {
    function revealLinkedSection() {
      let id;
      try { id = decodeURIComponent(window.location.hash.slice(1)); }
      catch (error) { return; }
      const target = document.getElementById(id);
      if (!target) return;
      let wasClosed = false;
      for (let node = target; node; node = node.parentElement) {
        if (node.tagName === "DETAILS" && !node.open) {
          node.open = true;
          wasClosed = true;
        }
      }
      if (wasClosed) target.scrollIntoView({ block: "start", behavior: "instant" });
    }
    revealLinkedSection();
    window.addEventListener("hashchange", revealLinkedSection);
  });
</script>


  <button onclick="window.scrollTo({top: 0, behavior: 'smooth'})" class="back-to-top" aria-label="Back to top">
    ↑
  </button>

  <script>
    /* =========================================================
       Active-section navbar highlighting.
       Scroll-position based, so short sections still highlight reliably.
       Works for both the vertical navbar and the horizontal/mobile navbar.
       ========================================================= */
    document.addEventListener("DOMContentLoaded", () => {
      const navLinks = Array.from(
        document.querySelectorAll("#vertical-navbar a[href^='#'], .top-navbar a[href^='#']")
      );

      const sectionIds = Array.from(
        new Set(
          navLinks
            .map((link) => link.getAttribute("href"))
            .filter((href) => href && href.startsWith("#") && href.length > 1)
            .map((href) => href.slice(1))
        )
      );

      const sections = sectionIds
        .map((id) => document.getElementById(id))
        .filter(Boolean);

      function setActiveNav(sectionId) {
        navLinks.forEach((link) => {
          link.classList.toggle("active", link.getAttribute("href") === `#${sectionId}`);
        });
      }

      function currentSectionId() {
        if (sections.length === 0) return null;

        const probeY = Math.min(window.innerHeight * 0.34, 260);
        let current = sections[0].id;

        for (const section of sections) {
          const rect = section.getBoundingClientRect();

          if (rect.top <= probeY) {
            current = section.id;
          }
        }

        const nearBottom =
          window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4;

        if (nearBottom) {
          current = sections[sections.length - 1].id;
        }

        return current;
      }

      let ticking = false;

      function updateActiveNav() {
        const sectionId = currentSectionId();
        if (sectionId) setActiveNav(sectionId);
        ticking = false;
      }

      function requestActiveNavUpdate() {
        if (!ticking) {
          window.requestAnimationFrame(updateActiveNav);
          ticking = true;
        }
      }

      navLinks.forEach((link) => {
        link.addEventListener("click", () => {
          const target = link.getAttribute("href");
          if (target && target.startsWith("#")) {
            setActiveNav(target.slice(1));
          }
        });
      });

      updateActiveNav();
      window.addEventListener("scroll", requestActiveNavUpdate, { passive: true });
      window.addEventListener("resize", requestActiveNavUpdate);
      window.addEventListener("hashchange", requestActiveNavUpdate);
    });
  </script>
